<!DOCTYPE html>
<html lang="{{ lang or 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set _name = site.full_name or site.name -%}
  {%- set _desc = (description or site.description) | striptags | replace("\n", " ") | trim -%}
  {%- set _img = (image or site.og_image) -%}
  <title>{% if title %}{{ title }} | {{ _name }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ _desc }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {% if site.google_site_verification %}<meta name="google-site-verification" content="{{ site.google_site_verification }}">{% endif %}
  {% if site.bing_site_verification %}<meta name="msvalidate.01" content="{{ site.bing_site_verification }}">{% endif %}

  <meta property="og:type" content="{% if layout == 'layouts/post.njk' %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ _desc }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ _name }}">
  <meta property="og:locale" content="en_US">
  {% if _img %}<meta property="og:image" content="{% if _img.startsWith('http') %}{{ _img }}{% else %}{{ site.url }}{{ _img }}{% endif %}">{% endif %}
  {% if layout == 'layouts/post.njk' %}
  <meta property="article:published_time" content="{{ page.date | isoDate }}">
  <meta property="article:modified_time" content="{{ (modified or page.date) | isoDate }}">
  <meta property="article:author" content="{{ site.url }}/about/">
  {% endif %}
  <meta name="twitter:card" content="{% if _img %}summary_large_image{% else %}summary{% endif %}">
  <meta name="twitter:title" content="{{ title or site.title }}">
  <meta name="twitter:description" content="{{ _desc }}">
  {% if _img %}<meta name="twitter:image" content="{% if _img.startsWith('http') %}{{ _img }}{% else %}{{ site.url }}{{ _img }}{% endif %}">{% endif %}

  <link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="{{ site.url }}/feed.xml">
  <meta name="author" content="{{ site.author }}">
  <meta name="robots" content="{% if page.url == '/analytics/' or page.url == '/seo-tool/' %}noindex, nofollow{% else %}index, follow, max-image-preview:large, max-snippet:-1{% endif %}">

  {% if site.ga4_id %}
  <!-- Google Analytics 4: tracks traffic sources, UTM campaigns, referrers -->
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.ga4_id }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ site.ga4_id }}');
  </script>
  {% endif %}

  {% if site.plausible_domain %}
  <script defer data-domain="{{ site.plausible_domain }}" src="https://plausible.io/js/script.outbound-links.js"></script>
  {% endif %}


  <link rel="preload" href="/fonts/dm-sans-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/fraunces-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
  {% if site.brand_green or site.brand_orange or site.brand_cream %}
  <style>
    :root {
      {% if site.brand_green %}--green-deep: {{ site.brand_green }};{% endif %}
      {% if site.brand_orange %}--orange: {{ site.brand_orange }};{% endif %}
      {% if site.brand_cream %}--cream: {{ site.brand_cream }};{% endif %}
    }
  </style>
  {% endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "{{ site.url }}/#person",
        "name": {{ _name | dump | safe }},
        "url": "{{ site.url }}/",
        "jobTitle": "Digital product coach and creator",
        "description": {{ site.description | replace("\n", " ") | dump | safe }},
        "knowsAbout": ["Digital products", "Selling online", "Content marketing", "Meta Ads", "Offer design", "Creator business", "Quality assurance"],
        "sameAs": [{{ site.instagram | dump | safe }}, {{ site.youtube | dump | safe }}{% if site.threads %}, {{ site.threads | dump | safe }}{% endif %}]
      },
      {
        "@type": "WebSite",
        "@id": "{{ site.url }}/#website",
        "name": {{ _name | dump | safe }},
        "url": "{{ site.url }}/",
        "description": {{ site.description | replace("\n", " ") | dump | safe }},
        "inLanguage": "en",
        "publisher": { "@id": "{{ site.url }}/#person" }
      }
      {% if layout == 'layouts/post.njk' %},
      {
        "@type": "Article",
        "@id": "{{ site.url }}{{ page.url }}#article",
        "headline": {{ title | dump | safe }},
        "description": {{ _desc | dump | safe }},
        "author": { "@id": "{{ site.url }}/#person" },
        "publisher": { "@id": "{{ site.url }}/#person" },
        "datePublished": "{{ page.date | isoDate }}",
        "dateModified": "{{ (modified or page.date) | isoDate }}",
        "mainEntityOfPage": "{{ site.url }}{{ page.url }}",
        "isPartOf": { "@id": "{{ site.url }}/#website" },
        "inLanguage": "en"{% if _img %},
        "image": "{% if _img.startsWith('http') %}{{ _img }}{% else %}{{ site.url }}{{ _img }}{% endif %}"{% endif %}
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/" },
          { "@type": "ListItem", "position": 2, "name": "Articles", "item": "{{ site.url }}/articles/" },
          { "@type": "ListItem", "position": 3, "name": {{ title | dump | safe }}, "item": "{{ site.url }}{{ page.url }}" }
        ]
      }
      {% elif page.url == '/about/' %},
      {
        "@type": "AboutPage",
        "@id": "{{ site.url }}/about/#page",
        "url": "{{ site.url }}/about/",
        "name": {{ title | dump | safe }},
        "mainEntity": { "@id": "{{ site.url }}/#person" }
      }
      {% endif %}
    ]
  }
  </script>
</head>
<body>

  <nav class="nav">
    <div class="nav-inner">
      <a class="brand" href="/">{{ site.name }}<span>.</span></a>
      <div class="nav-links">
        <a href="/articles/">Articles</a>
        {% for p in collections.navPages %}
        <a href="{{ p.url }}" class="hide-mobile">{{ p.data.nav_label or p.data.title }}</a>
        {% endfor %}
        <a href="{{ site.community_url }}" class="btn" rel="noopener">{{ site.nav_button or "Get the roadmap" }}</a>
      </div>
    </div>
  </nav>

  <main>
    {{ content | safe }}
  </main>

  <footer>
    <div class="footer-inner">
      <div>&copy; {% year %} {{ site.name }}. All rights reserved.</div>
      <div class="footer-links">
        <a href="/articles/">Articles</a>
        {% for p in collections.navPages %}
        <a href="{{ p.url }}">{{ p.data.nav_label or p.data.title }}</a>
        {% endfor %}
        <a href="{{ site.instagram }}" rel="noopener">Instagram</a>
        <a href="{{ site.youtube }}" rel="noopener">YouTube</a>
        <a href="/feed.xml">RSS</a>
        <a href="/impressum/">Impressum</a>
        <a href="/datenschutz/">Datenschutz</a>
      </div>
    </div>
  </footer>

  {% if site.internal_analytics != false %}
  <script>
  /* CTA click tracking: fires whenever someone clicks a community/CTA
     button, tagged with the page they clicked it from, so the
     dashboard can show which article's CTA gets clicked most. */
  (function () {
    if (window.location.pathname.indexOf("/admin") === 0) return;
    document.addEventListener("click", function (ev) {
      var btn = ev.target.closest(".callout .btn, .band .btn");
      if (!btn) return;
      var payload = {
        type: "cta_click",
        path: window.location.pathname,
        cta_destination: btn.href || ""
      };
      try {
        if (navigator.sendBeacon) {
          navigator.sendBeacon(
            "/.netlify/functions/track",
            new Blob([JSON.stringify(payload)], { type: "application/json" })
          );
        } else {
          fetch("/.netlify/functions/track", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
            keepalive: true
          });
        }
      } catch (e) { /* never block navigation */ }
    }, true);
  })();
  </script>
  {% endif %}

  {% if site.internal_analytics != false %}
  <script>
  /* Internal analytics beacon (self-hosted, not Google).
     Fires once per pageview, sends path/referrer/UTM/device to
     our own Netlify Function, which stores it in Netlify Blobs. */
  (function () {
    if (window.location.pathname.indexOf("/admin") === 0) return;
    var params = new URLSearchParams(window.location.search);
    var stored = null;
    try { stored = JSON.parse(localStorage.getItem("vlad_first_touch") || "null"); } catch (e) {}
    var payload = {
      path: window.location.pathname,
      referrer: document.referrer || "",
      utm_source: params.get("utm_source") || "",
      utm_medium: params.get("utm_medium") || "",
      utm_campaign: params.get("utm_campaign") || "",
      utm_content: params.get("utm_content") || "",
      first_source: (stored && stored.utm && stored.utm.utm_source) || ""
    };
    try {
      fetch("/.netlify/functions/track", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
        keepalive: true
      });
    } catch (e) { /* fail silently, never block the page */ }
  })();
  </script>
  {% endif %}

  <script>
  /* UTM engine:
     1. Captures inbound UTM parameters on first touch and remembers them for 30 days.
     2. Tags every outbound community link with utm_source, utm_medium,
        utm_campaign (the inbound campaign if one exists, otherwise "organic")
        and utm_content (the page that sent the click).
     Result: inside Skool/Circle and GA4 you can see exactly which article
     converted each visitor, and which ad or post brought them to the site. */
  (function () {
    var COMMUNITY = "{{ site.community_url }}";
    if (!COMMUNITY || COMMUNITY.indexOf("http") !== 0) return;
    var communityHost;
    try { communityHost = new URL(COMMUNITY).host; } catch (e) { return; }

    // 1. First-touch capture
    var KEY = "vlad_first_touch";
    var params = new URLSearchParams(window.location.search);
    var inbound = {};
    ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content"].forEach(function (k) {
      if (params.get(k)) inbound[k] = params.get(k);
    });
    var stored = null;
    try {
      stored = JSON.parse(localStorage.getItem(KEY) || "null");
      if (stored && Date.now() - stored.t > 30 * 864e5) stored = null;
      if (!stored && Object.keys(inbound).length) {
        stored = { t: Date.now(), utm: inbound, ref: document.referrer || "" };
        localStorage.setItem(KEY, JSON.stringify(stored));
      }
    } catch (e) { /* private mode etc., fail silently */ }

    // 2. Outbound tagging
    var slug = window.location.pathname.replace(/\/$/, "").split("/").pop() || "home";
    document.querySelectorAll('a[href]').forEach(function (a) {
      var url;
      try { url = new URL(a.href); } catch (e) { return; }
      if (url.host !== communityHost) return;
      url.searchParams.set("utm_source", "{{ site.utm_source }}");
      url.searchParams.set("utm_medium", "{{ site.utm_medium }}");
      url.searchParams.set("utm_content", slug);
      var campaign = (stored && stored.utm && stored.utm.utm_campaign) || "organic";
      url.searchParams.set("utm_campaign", campaign);
      if (stored && stored.utm && stored.utm.utm_source) {
        url.searchParams.set("first_source", stored.utm.utm_source);
      }
      a.href = url.toString();
    });
  })();
  </script>
</body>
</html>
